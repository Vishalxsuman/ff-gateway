# ==============================================================================
# FF Gateway — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ==============================================================================

# ── AUTHORIZED SESSION SOURCE ─────────────────────────────────────────────────
# Set FF_SESSION_JWT or both provider settings using an authorized issuer.
# Never commit real values. Keep secrets in Azure App Settings / Key Vault.
FF_SESSION_JWT=
FF_TOKEN_PROVIDER_URL=
FF_TOKEN_PROVIDER_SECRET=
FF_TOKEN_UPDATE_KEY=

# ── Protocol ─────────────────────────────────────────────────────────────────
FF_OB_VERSION=OB55
FF_FULL_BUILD_STRING=FFM_OB55_PRELive_MAX_2.133.1_2019118527_4636257_gp_unity2022_aab_sidekick_extend4641229-4641231_astc_sp

# ── AES-128-CBC Keys (update when Garena rotates keys after major patches) ───
AES_KEY=Yg&tc%DEuh6%Zc^8
AES_IV=6oyZDr22E3ychjM%

# ── Service Message IDs (from dump.cs reverse engineering) ───────────────────
SERVICE_MSG_PLAYER_SHOW=179

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO

# ── Cache ─────────────────────────────────────────────────────────────────────
ENABLE_CACHE=true
CACHE_TTL_SECONDS=300
# REDIS_URL=redis://localhost:6379/0

# ── Rate Limiting ─────────────────────────────────────────────────────────────
ENABLE_RATE_LIMIT=true
RATE_LIMIT_PER_UID=10

# ── Resilience ────────────────────────────────────────────────────────────────
GARENA_TIMEOUT_SECONDS=15
GARENA_MAX_RETRIES=2
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=60
TOKEN_REFRESH_BUFFER_SECONDS=300

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*
