# ==============================================================================
# FF Gateway — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ==============================================================================

# ── REQUIRED ──────────────────────────────────────────────────────────────────
# Garena guest account credentials used for auto-authentication.
# Get these by registering a guest account through the Free Fire mobile client
# or by capturing /MajorLogin traffic with Frida/mitmproxy.
FF_GUEST_UID=1948201948
FF_GUEST_PASSWORD=your_guest_account_password_here

# ── OPTIONAL: Static token override ──────────────────────────────────────────
# If set, the gateway uses this token instead of logging in.
# Useful for short-term deployments. Will be ignored if expired.
# FF_GUEST_TOKEN=eyJhbGciOiJIUzI1NiIs...

# ── Protocol ─────────────────────────────────────────────────────────────────
FF_OB_VERSION=OB55
FF_FULL_BUILD_STRING=FFM_OB55_PRELive_MAX_2.133.1_2019118527_4636257_gp_unity2022_aab_sidekick_extend4641229-4641231_astc_sp

# ── AES-128-CBC Keys (update when Garena rotates keys after major patches) ───
AES_KEY=Yg&tc%DEuh6%Zc^8
AES_IV=6oyZDr22E3ychjM%

# ── Service Message IDs (from dump.cs reverse engineering) ───────────────────
SERVICE_MSG_PLAYER_SHOW=179

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO

# ── Cache ─────────────────────────────────────────────────────────────────────
ENABLE_CACHE=true
CACHE_TTL_SECONDS=300
# REDIS_URL=redis://localhost:6379/0

# ── Rate Limiting ─────────────────────────────────────────────────────────────
ENABLE_RATE_LIMIT=true
RATE_LIMIT_PER_UID=10

# ── Resilience ────────────────────────────────────────────────────────────────
GARENA_TIMEOUT_SECONDS=15
GARENA_MAX_RETRIES=2
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=60
TOKEN_REFRESH_BUFFER_SECONDS=300

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*
